 .../feature/prompts/PromptFeature.kt          |  8 +++
 .../feature/prompts/file/FilePicker.kt        | 64 +++++++++++++++++++
 .../feature/prompts/file/FileSourceChooser.kt | 35 ++++++++++
 4 files changed, 109 insertions(+)
 create mode 100644 components/feature/prompts/src/main/java/mozilla/components/feature/prompts/file/FileSourceChooser.kt

