@@ -4,6 +4,8 @@
    - You can obtain one at http://mozilla.org/MPL/2.0/.  -->
 <paths>
     <external-path name="Download" path="." />
+    <!-- Profiles: app-only per-profile downloads -->
+    <files-path name="profileDownloads" path="profiles/"/>
     <external-files-path name="externalFilesDownload" path="Download/" />
 
     <!-- Offer access only to files under Context.getCacheDir()/media_share_cache/ -->
diff --git a/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/PromptFeature.kt b/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/PromptFeature.kt
index 53ec4239247a15f9e3fa139499c64fd7e0e24a07..04c2ac760f1acb9588085cc0614ee278aaca97bf 100644
--- a/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/PromptFeature.kt
+++ b/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/PromptFeature.kt
@@ -102,6 +102,7 @@ import mozilla.components.feature.prompts.facts.emitSuccessfulAddressAutofillFor
 import mozilla.components.feature.prompts.facts.emitSuccessfulCreditCardAutofillFormDetectedFact
 import mozilla.components.feature.prompts.file.AndroidPhotoPicker
 import mozilla.components.feature.prompts.file.FilePicker
+import mozilla.components.feature.prompts.file.FileSourceChooser
 import mozilla.components.feature.prompts.file.FileUploadsDirCleaner
 import mozilla.components.feature.prompts.identitycredential.DialogColors
 import mozilla.components.feature.prompts.identitycredential.DialogColorsProvider
@@ -397,6 +398,13 @@ private constructor(
             onNeedToRequestPermissions,
         )
 
+    // Profiles: optional chooser offered before the system file picker (null keeps the original behavior).
+    var fileSourceChooser: FileSourceChooser?
+        get() = filePicker.fileSourceChooser
+        set(value) {
+            filePicker.fileSourceChooser = value
