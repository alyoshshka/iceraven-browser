+
     @VisibleForTesting(otherwise = PRIVATE) internal var certificatePicker = CertificatePicker(container)
 
     @VisibleForTesting(otherwise = PRIVATE)
diff --git a/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/file/FilePicker.kt b/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/file/FilePicker.kt
index cafc7961b8524f11a773a224eb13812fdc909d68..e0a4bd0fc8c926d76b79fa4be37adef33d413139 100644
--- a/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/file/FilePicker.kt
+++ b/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/file/FilePicker.kt
@@ -61,6 +61,12 @@ internal class FilePicker(
 
     private val logger = Logger("FilePicker")
 
+    // Profiles: when set, the user is first asked where to upload from (app files / device / camera).
+    @VisibleForTesting internal var fileSourceChooser: FileSourceChooser? = null
+
+    // Profiles: only the capture intents are wanted for the current request.
+    private var captureOnly = false
+
     /** Cache of the current request to be used after permission is granted. */
     @VisibleForTesting internal var currentRequest: PromptRequest? = null
 
@@ -70,6 +76,48 @@ internal class FilePicker(
      * @param promptRequest The [File] prompt request.
      */
     fun handleFileRequest(promptRequest: File) {
+        val chooser = fileSourceChooser
+        if (chooser == null) {
+            handleSystemFileRequest(promptRequest)
+            return
+        }
+        // Profiles: let the app offer its own files first.
+        captureOnly = false
+        chooser.chooseSource(
+            FileSourceRequest(
+                request = promptRequest,
+                canCapture = MimeType.values().any { it.matches(promptRequest.mimeTypes) && it.capturePermission != null },
+                onDeviceFiles = { handleSystemFileRequest(promptRequest) },
+                onCamera = {
+                    captureOnly = true
+                    handleSystemFileRequest(promptRequest)
+                },
+                onFilesChosen = { uris -> deliverChosenFiles(promptRequest, uris) },
+                onCancel = {
+                    store.consumePromptFrom(sessionId, promptRequest.uid) { promptRequest.onDismiss() }
+                },
+            ),
+        )
+    }
+
+    // Profiles: hands app-chosen content Uris to the page, like a picker result would.
+    private fun deliverChosenFiles(promptRequest: File, uris: List<Uri>) {
+        store.consumePromptFrom(sessionId, promptRequest.uid) {
+            when {
+                uris.isEmpty() -> promptRequest.onDismiss()
+                promptRequest.isMultipleFilesSelection -> {
+                    uris.forEach { enqueueForCleanup(container.context, it) }
+                    promptRequest.onMultipleFilesSelected(container.context, uris.toTypedArray())
+                }
+                else -> {
+                    enqueueForCleanup(container.context, uris.first())
+                    promptRequest.onSingleFileSelected(container.context, uris.first())
+                }
+            }
+        }
+    }
+
+    private fun handleSystemFileRequest(promptRequest: File) {
         // Track which permissions are needed.
         val neededPermissions = getNecessaryPermissions(promptRequest)
 
@@ -254,6 +302,22 @@ internal class FilePicker(
     @VisibleForTesting
     internal fun onPermissionsGranted(promptRequest: File) {
         val intents = buildIntentList(promptRequest)
+        // Profiles: "Camera" source - keep only the capture intents (they carry EXTRA_OUTPUT or a capture action).
+        if (captureOnly) {
+            captureOnly = false
+            val captureIntents = intents.filter {
+                it.action == android.provider.MediaStore.ACTION_IMAGE_CAPTURE ||
+                    it.action == android.provider.MediaStore.ACTION_VIDEO_CAPTURE ||
+                    it.action == android.provider.MediaStore.Audio.Media.RECORD_SOUND_ACTION
+            }.toMutableList()
+            if (captureIntents.isNotEmpty()) {
+                showChooser(captureIntents)
+            } else if (intents.isNotEmpty()) {
+                // buildIntentList may already have launched a capture activity (captureMode) and returned empty.
+                showChooser(intents)
+            }
+            return
+        }
         showChooser(intents)
     }
 
diff --git a/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/file/FileSourceChooser.kt b/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/file/FileSourceChooser.kt
new file mode 100644
index 0000000000000000000000000000000000000000..6702a97f238075328e5aab9ba723060d996ef4a9
--- /dev/null
+++ b/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/file/FileSourceChooser.kt
@@ -0,0 +1,35 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package mozilla.components.feature.prompts.file
+
+import android.net.Uri
+import mozilla.components.concept.engine.prompt.PromptRequest
+
+// Profiles: optional hook letting the app offer its own file source before the system picker.
+
+/**
+ * A pending web page file request, handed to a [FileSourceChooser] together with the ways to answer it.
+ *
+ * @property request The original [PromptRequest.File] (accepted mime types, single or multiple selection).
+ * @property canCapture Whether the existing prompt would offer taking a photo, video or audio.
+ * @property onDeviceFiles Continue with the regular system file picker.
+ * @property onCamera Continue with the capture (camera/recorder) intents only.
+ * @property onFilesChosen Deliver the chosen content Uris to the page (one Uri for single selection).
+ * @property onCancel Dismiss the request.
+ */
+class FileSourceRequest(
+    val request: PromptRequest.File,
+    val canCapture: Boolean,
+    val onDeviceFiles: () -> Unit,
+    val onCamera: () -> Unit,
+    val onFilesChosen: (List<Uri>) -> Unit,
+    val onCancel: () -> Unit,
+)
+
+/** Shows the app's own "Upload from" chooser. Exactly one of the callbacks in [FileSourceRequest] must be invoked. */
+fun interface FileSourceChooser {
+    /** Offer the sources for [source]. */
+    fun chooseSource(source: FileSourceRequest)
+}
