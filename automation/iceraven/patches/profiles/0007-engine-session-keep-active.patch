+internal class KeepActiveGeckoSession(settings: GeckoSessionSettings) : GeckoSession(settings) {
+    @Volatile
+    var keepActive: Boolean = false
+
+    override fun setActive(active: Boolean) {
+        super.setActive(active || keepActive)
+    }
